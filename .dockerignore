# Ignore node modules and lock files
node_modules
npm-debug.log
yarn-error.log
pnpm-lock.yaml

# Ignore version control
.git
.gitignore

# Ignore Docker files
Dockerfile
.dockerignore

# Ignore system and editor files
*.swp
*.swo
*.DS_Store
.vscode
.idea

# Ignore build artifacts
.next
dist
build

# Ignore env files (optional if you're mounting them manually)
.env
.env.local

# Never place committed historical runtime env material into a container image.
.env.*

# Obsolete Firebase key material and standalone admin tooling must never
# enter the parser container, even if tracked in historical Git commits.
serviceAccountKey.json
serviceAccountKey*.json
firebase_utils.py
sync_firebase_users.py
utils/auth_utils.py
scripts/list_firebase_users.py
scripts/delete_firebase_users.py
